# 复制本文件为 .env 并填写

# SQLite 数据库文件路径（相对 server 目录）
DATABASE_URL="file:./dev.db"

# JWT 签名密钥：生产环境务必改成随机长字符串
JWT_SECRET="dev-secret-change-me"

# HTTP 端口
PORT=4000

# ---------- AI 服务配置（配任意一家即可启用 AI 功能） ----------

# 供应商选择：auto（默认，哪个 Key 配了用哪个，都配了优先 DeepSeek）| deepseek | anthropic
AI_PROVIDER="auto"

# DeepSeek API Key：在 https://platform.deepseek.com 获取（详见 README，价格极低）
DEEPSEEK_API_KEY=""

# Claude API Key：在 https://console.anthropic.com 获取（详见 README）
ANTHROPIC_API_KEY=""

# ---------- 联网搜索（可选，开启后 AI 能回答最新资讯） ----------

# 搜索服务选择：auto（默认，哪个 Key 配了用哪个，都配了优先博查）| tavily | bocha
SEARCH_PROVIDER="auto"

# 博查 AI 搜索：https://open.bochaai.com 获取（国内服务，中文结果好）
BOCHA_API_KEY=""

# Tavily 搜索：https://tavily.com 获取（海外服务，免费额度 1000 次/月）
TAVILY_API_KEY=""
